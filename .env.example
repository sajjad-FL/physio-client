VITE_API_URL=http://localhost:5000/api

# Public marketing site origin (no trailing slash). Used for canonical, Open Graph, Twitter cards, and JSON-LD.
# In production builds, also used to write absolute URLs into dist/robots.txt and dist/sitemap.xml.
# Local dev: http://localhost:5173 — Production: https://physiokhom.com
# Production builds also read committed .env.production unless the host sets VITE_PUBLIC_SITE_URL (CI overrides file).
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Optional: comma-separated cities or regions you serve (shown on home + LocalBusiness areaServed in JSON-LD).
# Example: VITE_PRIMARY_SERVICE_AREAS=Bengaluru,Mumbai,Hyderabad
# VITE_PRIMARY_SERVICE_AREAS=

# Optional: API origin for a second Sitemap line in robots.txt (when the API is on another host and serves /api/seo/physio-sitemap.xml).
# VITE_API_PUBLIC_ORIGIN=https://api.example.com
